# Copy this file to .env and adjust the values. Never commit .env.

# Used by docker compose to create the database
POSTGRES_USER=findoc
POSTGRES_PASSWORD=findoc
POSTGRES_DB=findoc

# Used by the API when it runs outside docker compose
DATABASE_URL=postgresql://findoc:findoc@localhost:5432/findoc

# Embeddings. Get a key at https://dash.voyageai.com (API Keys).
# Set EMBEDDING_PROVIDER=fake to work without a key (meaningless vectors, for tests only).
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=

# Client-side rate limits for indexing. Defaults match Voyage's free trial (no payment method).
# With a payment method (usage tier 1), voyage-4 allows 2000 requests and 8,000,000 tokens per minute.
EMBEDDING_REQUESTS_PER_MINUTE=3
EMBEDDING_TOKENS_PER_MINUTE=10000
